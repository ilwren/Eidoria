<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:spike="using:MdExplorer.LibMpvAvaloniaSpike"
        xmlns:mpv="using:HanumanInstitute.LibMpv.Avalonia"
        x:Class="MdExplorer.LibMpvAvaloniaSpike.MainWindow"
        x:DataType="spike:MainWindow"
        Width="1000" Height="680" MinWidth="560" MinHeight="420"
        Title="Eidoria · libmpv Spike">
  <Grid RowDefinitions="*,Auto,Auto" Margin="16" RowSpacing="12">
    <Border Grid.Row="0" Background="#090A0D" CornerRadius="12" ClipToBounds="True">
      <mpv:MpvView x:Name="PlayerView"
                   MpvContext="{Binding Mpv, Mode=OneWayToSource}"
                   Renderer="Auto" />
    </Border>

    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
      <Button x:Name="OpenButton" Content="打开媒体文件…" />
      <Button x:Name="PlayPauseButton" Content="播放 / 暂停" />
      <Button x:Name="StopButton" Content="停止" />
      <Button x:Name="BackButton" Content="−10 秒" />
      <Button x:Name="ForwardButton" Content="+10 秒" />
    </StackPanel>

    <TextBlock x:Name="StatusText" Grid.Row="2" TextWrapping="Wrap"
               Foreground="Gray"
               Text="选择本地音频或视频文件。需要另行安装经审核的 LGPL-only libmpv 原生运行库。" />
  </Grid>
</Window>
