<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="using:Md3.Avalonia.Controls"
             xmlns:vm="using:MdExplorer.UI.ViewModels"
             x:Class="MdExplorer.UI.Views.SettingsView"
             x:DataType="vm:ShellViewModel">
  <Grid RowDefinitions="Auto,*">
    <Border Grid.Row="0" Margin="24,14,24,8" Padding="18,14" CornerRadius="22"
            Background="{DynamicResource Md.Sys.Color.SurfaceContainerLow.Brush}"
            BorderBrush="{DynamicResource Md.Sys.Color.OutlineVariant.Brush}" BorderThickness="1">
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
        <Border Width="44" Height="44" CornerRadius="16" VerticalAlignment="Center"
                Background="{DynamicResource Md.Sys.Color.PrimaryContainer.Brush}">
          <md:MdIcon Glyph="{x:Static md:MdSymbols.Settings}" Size="23" HorizontalAlignment="Center" VerticalAlignment="Center"
                     Foreground="{DynamicResource Md.Sys.Color.OnPrimaryContainer.Brush}" />
        </Border>
        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
          <TextBlock Classes="h1" Text="设置" />
          <TextBlock Classes="caption" Foreground="{DynamicResource Md.Sys.Color.OnSurfaceVariant.Brush}"
                     Text="偏好设置会即时生效，并保存在本机。" TextWrapping="Wrap" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid x:Name="SettingsResponsiveLayout" Grid.Row="1" ColumnDefinitions="0,*"
          ColumnSpacing="18" Margin="24,4,24,24" SizeChanged="OnSettingsLayoutSizeChanged">
      <Border x:Name="WideSettingsNavigation" Grid.Column="0" IsVisible="False" Padding="12"
              CornerRadius="20" VerticalAlignment="Stretch"
              Background="{DynamicResource Md.Sys.Color.SurfaceContainerLow.Brush}"
              BorderBrush="{DynamicResource Md.Sys.Color.OutlineVariant.Brush}" BorderThickness="1">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="6">
            <TextBlock Classes="caption" Text="设置分类" Margin="10,6,0,8"
                       Foreground="{DynamicResource Md.Sys.Color.OnSurfaceVariant.Brush}" />
      <md:MdButton x:Name="WideNavAppearance" Classes="settings-nav-item" Variant="Text"
                   Tag="appearance" Click="OnSettingsNavigationClick" HorizontalAlignment="Stretch"
                   HorizontalContentAlignment="Left">
        <Grid ColumnDefinitions="40,*" ColumnSpacing="10">
          <Border Width="34" Height="34" CornerRadius="12" Background="{DynamicResource Md.Sys.Color.SurfaceContainer.Brush}">
            <md:MdIcon Glyph="{x:Static md:MdSymbols.Tune}" Size="19" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{DynamicResource Md.Sys.Color.OnSurfaceVariant.Brush}" />
          </Border>
          <TextBlock Grid.Column="1" Text="外观" VerticalAlignment="Center" />
        </Grid>
      </md:MdButton>
      <md:MdButton x:Name="WideNavBrowse" Classes="settings-nav-item" Variant="Text"
                   Tag="browse" Click="OnSettingsNavigationClick" HorizontalAlignment="Stretch"
                   HorizontalContentAlignment="Left">
        <Grid ColumnDefinitions="40,*" ColumnSpacing="10">
          <Border Width="34" Height="34" CornerRadius="12" Background="{DynamicResource Md.Sys.Color.SurfaceContainer.Brush}">
            <md:MdIcon Glyph="{x:Static md:MdSymbols.FolderOpen}" Size="19" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{DynamicResource Md.Sys.Color.OnSurfaceVariant.Brush}" />
          </Border>
          <TextBlock Grid.Column="1" Text="浏览" VerticalAlignment="Center" />
        </Grid>
      </md:MdButton>
      <md:MdButton x:Name="WideNavStartup" Classes="settings-nav-item" Variant="Text"
                   Tag="startup" Click="OnSettingsNavigationClick" HorizontalAlignment="Stretch"
                   HorizontalContentAlignment="Left">
        <Grid ColumnDefinitions="40,*" ColumnSpacing="10">
          <Border Width="34" Height="34" CornerRadius="12" Background="{DynamicResource Md.Sys.Color.SurfaceContainer.Brush}">
            <md:MdIcon Glyph="{x:Static md:MdSymbols.Settings}" Size="19" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{DynamicResource Md.Sys.Color.OnSurfaceVariant.Brush}" />
          </Border>
          <TextBlock Grid.Column="1" Text="启动与最近" VerticalAlignment="Center" />
        </Grid>
      </md:MdButton>
      <md:MdButton x:Name="WideNavMedia" Classes="settings-nav-item" Variant="Text"
                   Tag="media" Click="OnSettingsNavigationClick" HorizontalAlignment="Stretch"
                   HorizontalContentAlignment="Left">
        <Grid ColumnDefinitions="40,*" ColumnSpacing="10">
          <Border Width="34" Height="34" CornerRadius="12" Background="{DynamicResource Md.Sys.Color.SurfaceContainer.Brush}">
            <md:MdIcon Glyph="{x:Static md:MdSymbols.Movie}" Size="19" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{DynamicResource Md.Sys.Color.OnSurfaceVariant.Brush}" />
          </Border>
          <TextBlock Grid.Column="1" Text="媒体" VerticalAlignment="Center" />
        </Grid>
      </md:MdButton>
      <md:MdButton x:Name="WideNavAiSearch" Classes="settings-nav-item" Variant="Text"
                   Tag="ai-search" Click="OnSettingsNavigationClick" HorizontalAlignment="Stretch"
                   HorizontalContentAlignment="Left">
        <Grid ColumnDefinitions="40,*" ColumnSpacing="10">
          <Border Width="34" Height="34" CornerRadius="12" Background="{DynamicResource Md.Sys.Color.SurfaceContainer.Brush}">
            <md:MdIcon Glyph="{x:Static md:MdSymbols.Search}" Size="19" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{DynamicResource Md.Sys.Color.OnSurfaceVariant.Brush}" />
          </Border>
          <TextBlock Grid.Column="1" Text="AI 与搜索" VerticalAlignment="Center" />
        </Grid>
      </md:MdButton>
      <md:MdButton x:Name="WideNavStorage" Classes="settings-nav-item" Variant="Text"
                   Tag="storage" Click="OnSettingsNavigationClick" HorizontalAlignment="Stretch"
                   HorizontalContentAlignment="Left">
        <Grid ColumnDefinitions="40,*" ColumnSpacing="10">
          <Border Width="34" Height="34" CornerRadius="12" Background="{DynamicResource Md.Sys.Color.SurfaceContainer.Brush}">
            <md:MdIcon Glyph="{x:Static md:MdSymbols.FolderOpen}" Size="19" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{DynamicResource Md.Sys.Color.OnSurfaceVariant.Brush}" />
          </Border>
          <TextBlock Grid.Column="1" Text="存储与权限" VerticalAlignment="Center" />
        </Grid>
      </md:MdButton>
      <md:MdButton x:Name="WideNavNotifications" Classes="settings-nav-item" Variant="Text"
                   Tag="notifications" Click="OnSettingsNavigationClick" HorizontalAlignment="Stretch"
                   HorizontalContentAlignment="Left">
        <Grid ColumnDefinitions="40,*" ColumnSpacing="10">
          <Border Width="34" Height="34" CornerRadius="12" Background="{DynamicResource Md.Sys.Color.SurfaceContainer.Brush}">
            <md:MdIcon Glyph="{x:Static md:MdSymbols.NotificationsActive}" Size="19" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{DynamicResource Md.Sys.Color.OnSurfaceVariant.Brush}" />
          </Border>
          <TextBlock Grid.Column="1" Text="通知" VerticalAlignment="Center" />
        </Grid>
      </md:MdButton>
      <md:MdButton x:Name="WideNavAbout" Classes="settings-nav-item" Variant="Text"
                   Tag="about" Click="OnSettingsNavigationClick" HorizontalAlignment="Stretch"
                   HorizontalContentAlignment="Left">
        <Grid ColumnDefinitions="40,*" ColumnSpacing="10">
          <Border Width="34" Height="34" CornerRadius="12" Background="{DynamicResource Md.Sys.Color.SurfaceContainer.Brush}">
            <md:MdIcon Glyph="{x:Static md:MdSymbols.Info}" Size="19" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{DynamicResource Md.Sys.Color.OnSurfaceVariant.Brush}" />
          </Border>
          <TextBlock Grid.Column="1" Text="关于" VerticalAlignment="Center" />
        </Grid>
      </md:MdButton>
          </StackPanel>
        </ScrollViewer>
      </Border>

      <Grid Grid.Column="1" RowDefinitions="Auto,*" RowSpacing="10">
        <WrapPanel x:Name="CompactSettingsNavigation" Grid.Row="0" Orientation="Horizontal" IsVisible="True">
        <md:MdButton x:Name="CompactNavAppearance" Classes="settings-nav-chip" Variant="Text"
                     Tag="appearance" Click="OnSettingsNavigationClick" Content="外观" />
        <md:MdButton x:Name="CompactNavBrowse" Classes="settings-nav-chip" Variant="Text"
                     Tag="browse" Click="OnSettingsNavigationClick" Content="浏览" />
        <md:MdButton x:Name="CompactNavStartup" Classes="settings-nav-chip" Variant="Text"
                     Tag="startup" Click="OnSettingsNavigationClick" Content="启动与最近" />
        <md:MdButton x:Name="CompactNavMedia" Classes="settings-nav-chip" Variant="Text"
                     Tag="media" Click="OnSettingsNavigationClick" Content="媒体" />
        <md:MdButton x:Name="CompactNavAiSearch" Classes="settings-nav-chip" Variant="Text"
                     Tag="ai-search" Click="OnSettingsNavigationClick" Content="AI 与搜索" />
        <md:MdButton x:Name="CompactNavStorage" Classes="settings-nav-chip" Variant="Text"
                     Tag="storage" Click="OnSettingsNavigationClick" Content="存储与权限" />
        <md:MdButton x:Name="CompactNavNotifications" Classes="settings-nav-chip" Variant="Text"
                     Tag="notifications" Click="OnSettingsNavigationClick" Content="通知" />
        <md:MdButton x:Name="CompactNavAbout" Classes="settings-nav-chip" Variant="Text"
                     Tag="about" Click="OnSettingsNavigationClick" Content="关于" />
        </WrapPanel>
        <md:MdScrollViewer x:Name="SettingsContentScroll" Grid.Row="1"
                           HorizontalScrollBarVisibility="Disabled" AllowMouseDrag="True">
          <!-- v0.61：占满可见宽度，不再留 900 DIP 上限；宽屏下左侧是固定的设置分类栏。 -->
          <StackPanel x:Name="SettingsContent" HorizontalAlignment="Stretch" Spacing="16" Margin="0,0,0,24">
            <StackPanel Spacing="4" Margin="2,0,0,2">
              <TextBlock x:Name="SettingsSectionTitle" Classes="h2" Text="外观" />
              <TextBlock x:Name="SettingsSectionSubtitle" Classes="body" TextWrapping="Wrap"
                         Foreground="{DynamicResource Md.Sys.Color.OnSurfaceVariant.Brush}"
                         Text="主题、颜色与界面密度" />
            </StackPanel>
          <Border Classes="card settings-card" x:Name="SettingsCardAppearance">
            <StackPanel Spacing="10">
              <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,0,0,4">
                <Border Width="40" Height="40" CornerRadius="20"
                        Background="{DynamicResource Md.Sys.Color.SecondaryContainer.Brush}">
                  <md:MdIcon Glyph="{x:Static md:MdSymbols.Tune}" Size="20" HorizontalAlignment="Center" VerticalAlignment="Center"
                             Foreground="{DynamicResource Md.Sys.Color.OnSecondaryContainer.Brush}" />
              </Border>
          <TextBlock Classes="h3" Text="外观" VerticalAlignment="Center" />
        </StackPanel>
        <!-- v0.61：改用 Md3 分段按钮组，单选语义直接写在控件形态上（Md3.Avalonia MdSegmentedButtonGroup）。 -->
        <md:MdSegmentedButtonGroup SelectedValue="{Binding ThemeMode, Mode=TwoWay}"
                                   SelectedValueBinding="{Binding Value}">
          <md:MdSegmentedButton Value="System" Content="跟随系统" ToolTip.Tip="随系统明暗切换" />
          <md:MdSegmentedButton Value="Light" Content="浅色" />
          <md:MdSegmentedButton Value="Dark" Content="深色" />
        </md:MdSegmentedButtonGroup>
        <TextBlock Classes="caption">
          <Run Text="当前主题：" /><Run Text="{Binding ThemeModeText}" />
        </TextBlock>
        <TextBlock Classes="body" Text="主题色" Margin="0,6,0,0" />
        <WrapPanel x:Name="SeedPanel" Orientation="Horizontal" />
        <TextBlock Classes="caption">
          <Run Text="当前种子色：" /><Run Text="{Binding SeedColor}" />
        </TextBlock>
        <StackPanel Spacing="2" Margin="0,8,0,0">
          <TextBlock Classes="body" Text="列表密度" />
          <TextBlock Classes="caption" TextWrapping="Wrap" Text="紧凑会收紧列表行高、网格间距与详细信息行高；图标井、选中描边和拖放目标保持不变" />
          <md:MdSegmentedButtonGroup Margin="0,6,0,0" SelectedValue="{Binding Density, Mode=TwoWay}"
                                     SelectedValueBinding="{Binding Value}">
            <md:MdSegmentedButton Value="Comfortable" Content="舒适" />
            <md:MdSegmentedButton Value="Compact" Content="紧凑" />
          </md:MdSegmentedButtonGroup>
        </StackPanel>
        <Grid ColumnDefinitions="*,Auto" Margin="0,6,0,0">
          <StackPanel>
            <TextBlock Classes="body" Text="减少动态效果" />
            <TextBlock Classes="caption" Text="关闭目录/页面位移动画、侧栏微位移与文件卡悬停上浮" />
          </StackPanel>
          <md:MdSwitch Grid.Column="1" IsChecked="{Binding ReduceMotion}" VerticalAlignment="Center" />
        </Grid>
      </StackPanel>
      </Border>
          <Border Classes="card settings-card" x:Name="SettingsCardBrowse">
            <StackPanel Spacing="14">
              <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,0,0,4">
                <Border Width="40" Height="40" CornerRadius="20"
                        Background="{DynamicResource Md.Sys.Color.SecondaryContainer.Brush}">
                  <md:MdIcon Glyph="{x:Static md:MdSymbols.FolderOpen}" Size="20" HorizontalAlignment="Center" VerticalAlignment="Center"
                             Foreground="{DynamicResource Md.Sys.Color.OnSecondaryContainer.Brush}" />
              </Border>
          <TextBlock Classes="h3" Text="浏览" VerticalAlignment="Center" />
        </StackPanel>
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel>
            <TextBlock Classes="body" Text="显示隐藏文件" />
            <TextBlock Classes="caption" Text="展示以点开头或带隐藏属性的项目" />
          </StackPanel>
          <md:MdSwitch Grid.Column="1" IsChecked="{Binding ShowHidden}" VerticalAlignment="Center" />
        </Grid>
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel>
            <TextBlock Classes="body" Text="文件夹在前" />
            <TextBlock Classes="caption" Text="排序时文件夹优先于文件" />
          </StackPanel>
          <md:MdSwitch Grid.Column="1" IsChecked="{Binding FoldersFirst}" VerticalAlignment="Center" />
        </Grid>
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel>
            <TextBlock Classes="body" Text="预览侧栏（宽屏）" />
            <TextBlock Classes="caption" Text="在 Expanded 及更宽断点下选中文件时显示预览栏" />
          </StackPanel>
          <md:MdSwitch Grid.Column="1" IsChecked="{Binding ShowPreviewPane}" VerticalAlignment="Center" />
        </Grid>
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel>
            <TextBlock Classes="body" Text="按文件夹记忆视图与排序" />
            <TextBlock Classes="caption" Text="每个文件夹单独保存列表/网格/详细信息及排序；新文件夹仍用全局默认" />
          </StackPanel>
          <md:MdSwitch Grid.Column="1" IsChecked="{Binding RememberFolderView}" VerticalAlignment="Center" />
        </Grid>
        <md:MdButton Variant="Outlined" Content="清除文件夹视图记忆" HorizontalAlignment="Left"
                     Command="{Binding ClearFolderViewPreferencesCommand}" />
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel>
            <TextBlock Classes="body" Text="外部变更自动刷新" />
            <TextBlock Classes="caption" Text="其他程序增删改当前文件夹时自动同步列表" />
          </StackPanel>
          <md:MdSwitch Grid.Column="1" IsChecked="{Binding WatchFolderChanges}" VerticalAlignment="Center" />
        </Grid>
        <StackPanel Spacing="2" Margin="0,4,0,0">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Classes="body" Text="每页项目数" />
            <TextBlock Grid.Column="1" Classes="caption" Text="{Binding ItemPageSizeText}" VerticalAlignment="Center" />
          </Grid>
          <TextBlock Classes="caption" TextWrapping="Wrap"
                     Text="首屏与每次续载创建的行数；底层仍先完整枚举并统一排序，因此这是渐进呈现，不是磁盘分页读取" />
          <md:MdSlider Margin="0,6,0,0" Minimum="60" Maximum="480" TickFrequency="60"
                       IsSnapToTickEnabled="True" Value="{Binding ItemPageSizeNumber, Mode=TwoWay}"
                       ShowValueIndicator="True" ValueFormat="0"
                       ToolTip.Tip="拖动选择每页项目数（60–480，步进 60）"
                       AutomationProperties.Name="每页项目数" />
        </StackPanel>
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel>
            <TextBlock Classes="body" Text="滚动接近底部自动加载" />
            <TextBlock Classes="caption" Text="关闭后只在页脚点“加载更多”时续页；手动入口与快捷键始终保留" />
          </StackPanel>
          <md:MdSwitch Grid.Column="1" IsChecked="{Binding AutoLoadMore}" VerticalAlignment="Center" />
        </Grid>
        <StackPanel Spacing="2">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Classes="body" Text="自动续页距离" />
            <TextBlock Grid.Column="1" Classes="caption" Text="{Binding AutoLoadMoreDistanceText}" VerticalAlignment="Center" />
          </Grid>
          <TextBlock Classes="caption" TextWrapping="Wrap"
                     Text="距离列表底部多少时开始加载下一页；调大更早预取、调小更省内存" />
          <md:MdSlider Margin="0,6,0,0" Minimum="120" Maximum="600" TickFrequency="40"
                       IsSnapToTickEnabled="True" Value="{Binding AutoLoadMoreDistance, Mode=TwoWay}"
                       ShowValueIndicator="True" ValueFormat="0"
                       ToolTip.Tip="距列表底部多少 DIP 自动加载下一页（120–600）"
                       AutomationProperties.Name="自动续页距离" />
        </StackPanel>
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel>
            <TextBlock Classes="body" Text="图片缩略图" />
            <TextBlock Classes="caption" Text="关闭后图片只显示类型图标，并释放已生成的缩略图以节省内存" />
          </StackPanel>
          <md:MdSwitch Grid.Column="1" IsChecked="{Binding EnableThumbnails}" VerticalAlignment="Center" />
        </Grid>
        <!-- 缩略图档位与磁盘缓存：档位是缓存键的一部分，所以换档等于换一份缓存。 -->
        <StackPanel Spacing="6" IsVisible="{Binding EnableThumbnails}">
          <TextBlock Classes="body" Text="缩略图档位" />
          <TextBlock Classes="caption" TextWrapping="Wrap"
                     Text="档位只决定解码目标宽度：小档省内存与磁盘，大档在高分屏和网格视图里更清楚。换档会清掉已呈现的缩略图并按新档重新解码。" />
          <md:MdSegmentedButtonGroup SelectedValue="{Binding ThumbnailTierName, Mode=TwoWay}"
                                     SelectedValueBinding="{Binding Value}">
            <md:MdSegmentedButton Value="Small" Content="小 128" ToolTip.Tip="解码目标宽度 128 DIP，省内存与磁盘" />
            <md:MdSegmentedButton Value="Medium" Content="中 192" ToolTip.Tip="默认档位" />
            <md:MdSegmentedButton Value="Large" Content="大 288" ToolTip.Tip="高分屏与网格视图更清楚" />
          </md:MdSegmentedButtonGroup>
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel>
              <TextBlock Classes="body" Text="缩略图磁盘缓存" />
              <TextBlock Classes="caption" TextWrapping="Wrap" Text="{Binding ThumbnailCacheSummary}"
                         ToolTip.Tip="缓存按「路径 + 档位 + 大小 + 修改时间」记账，文件一改就自动重新生成；坏图记负缓存不再重试。上限 192 MB，超出后按最后使用时间自动清理。" />
            </StackPanel>
            <md:MdButton Grid.Column="1" Classes="segmented-choice" Variant="Text" Content="清空"
                         VerticalAlignment="Center" ToolTip.Tip="删除所有缓存文件；缩略图会在下次浏览时重新生成"
                         Command="{Binding ClearThumbnailCacheCommand}" />
          </Grid>
        </StackPanel>
        <!-- 全文内容索引：默认关；只在用户显式建立时才落盘。 -->
        <StackPanel Spacing="6" Margin="0,6,0,0">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel>
              <TextBlock Classes="body" Text="全文内容索引" />
              <TextBlock Classes="caption" TextWrapping="Wrap"
                         Text="在本机建立文件正文索引，搜索中心可跨文件夹找内容；收白名单文本扩展名（单文件 ≤ 512 KB），以及 Office / OpenDocument / 文本型 PDF 的正文。扫描件 PDF 需先 OCR，本版不做；索引与查询都不联网。" />
            </StackPanel>
            <md:MdSwitch Grid.Column="1" IsChecked="{Binding EnableContentIndex}" VerticalAlignment="Center"
                         ToolTip.Tip="关闭后全文搜索不可用；已建索引保留在应用数据目录，可手动清除" />
          </Grid>
          <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding EnableContentIndex}">
            <StackPanel>
              <TextBlock Classes="caption" TextWrapping="Wrap" Text="{Binding ContentIndexSummaryText}"
                         ToolTip.Tip="索引根沿用搜索中心里配置的文件夹；文件改动后重建会自动跳过未变内容" />
            </StackPanel>
            <md:MdButton Grid.Column="1" Classes="segmented-choice" Variant="Text" Content="清空"
                         VerticalAlignment="Center" IsEnabled="{Binding HasContentIndex}"
                         ToolTip.Tip="删除 content-index.db；不会删除任何用户文件"
                         Command="{Binding ClearContentIndexCommand}" />
          </Grid>
        </StackPanel>
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel>
            <TextBlock Classes="body" Text="移入回收站前确认" />
            <TextBlock Classes="caption" Text="关闭后删除选中项会直接移入回收站；永久删除没有恢复路径，始终要求确认" />
          </StackPanel>
          <md:MdSwitch Grid.Column="1" IsChecked="{Binding ConfirmBeforeTrash}" VerticalAlignment="Center" />
        </Grid>
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel>
            <TextBlock Classes="body" Text="下拉刷新手势" />
            <TextBlock Classes="caption" TextWrapping="Wrap"
                       Text="在文件面顶部向下拖触发刷新；关闭后工具栏刷新按钮与 F5/Ctrl+R 仍然可用" />
          </StackPanel>
          <md:MdSwitch Grid.Column="1" IsChecked="{Binding EnablePullRefresh}" VerticalAlignment="Center" />
        </Grid>
        <StackPanel Spacing="2" Margin="0,4,0,0">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Classes="body" Text="下拉刷新触发距离" />
            <TextBlock Grid.Column="1" Classes="caption" Text="{Binding PullTriggerText}" VerticalAlignment="Center" />
          </Grid>
          <TextBlock Classes="caption" TextWrapping="Wrap" Text="手指或鼠标从文件面顶部向下拖过该距离才触发刷新；桌面刷新按钮与 F5/Ctrl+R 不受影响" />
          <md:MdSlider Margin="0,6,0,0" Minimum="48" Maximum="120" TickFrequency="12"
                       IsSnapToTickEnabled="True" Value="{Binding PullRefreshTriggerDistance, Mode=TwoWay}"
                       ShowValueIndicator="True" ValueFormat="0"
                       ToolTip.Tip="下拉多少 DIP 触发刷新（48–120）"
                       AutomationProperties.Name="下拉刷新触发距离" />
        </StackPanel>
      </StackPanel>
      </Border>
          <Border Classes="card settings-card" x:Name="SettingsCardStartup">
            <StackPanel Spacing="12">
              <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,0,0,4">
                <Border Width="40" Height="40" CornerRadius="20"
                        Background="{DynamicResource Md.Sys.Color.SecondaryContainer.Brush}">
                  <md:MdIcon Glyph="{x:Static md:MdSymbols.Settings}" Size="20" HorizontalAlignment="Center" VerticalAlignment="Center"
                             Foreground="{DynamicResource Md.Sys.Color.OnSecondaryContainer.Brush}" />
              </Border>
          <TextBlock Classes="h3" Text="启动与最近" VerticalAlignment="Center" />
        </StackPanel>
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel>
            <TextBlock Classes="body" Text="启动时恢复上次标签页" />
            <TextBlock Classes="caption" TextWrapping="Wrap"
                       Text="关闭后每次启动只打开起始文件夹，并覆盖上一次的标签会话记录" />
          </StackPanel>
          <md:MdSwitch Grid.Column="1" IsChecked="{Binding RestoreTabsOnLaunch}" VerticalAlignment="Center" />
        </Grid>
        <StackPanel Spacing="2">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Classes="body" Text="最近访问保留条数" />
            <TextBlock Grid.Column="1" Classes="caption" Text="{Binding RecentLimitText}" VerticalAlignment="Center" />
          </Grid>
          <TextBlock Classes="caption" TextWrapping="Wrap" Text="同时约束主页最近访问与浏览历史记录；调小后立即裁剪最旧条目" />
          <md:MdSlider Margin="0,6,0,0" Minimum="6" Maximum="60" TickFrequency="6"
                       IsSnapToTickEnabled="True" Value="{Binding RecentItemLimitNumber, Mode=TwoWay}"
                       ShowValueIndicator="True" ValueFormat="0"
                       ToolTip.Tip="最近访问保留条数（6–60）"
                       AutomationProperties.Name="最近访问保留条数" />
        </StackPanel>
      </StackPanel>
      </Border>
          <Border Classes="card settings-card" x:Name="SettingsCardAbout">
            <StackPanel Spacing="8">
              <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,0,0,4">
                <Border Width="40" Height="40" CornerRadius="20"
                        Background="{DynamicResource Md.Sys.Color.SecondaryContainer.Brush}">
                  <md:MdIcon Glyph="{x:Static md:MdSymbols.Info}" Size="20" HorizontalAlignment="Center" VerticalAlignment="Center"
                             Foreground="{DynamicResource Md.Sys.Color.OnSecondaryContainer.Brush}" />
              </Border>
          <TextBlock Classes="h3" Text="关于" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock Classes="body">
          <Run Text="Eidoria（万象屿） " /><Run Text="{Binding AppVersionText}" />
        </TextBlock>
        <TextBlock Classes="caption" Text="Avalonia 12 · .NET 10 · Material Design 3（Md3.Avalonia）" />
        <TextBlock Classes="caption" TextWrapping="Wrap">
          <Run Text="数据目录：" /><Run Text="{Binding DataDirectoryText}" />
        </TextBlock>
        <!-- 折叠屏真机自查：没有传感器与摊平了必须分开说，否则分不清布局为什么不折 -->
        <TextBlock Classes="caption" TextWrapping="Wrap">
          <Run Text="设备姿态：" /><Run Text="{Binding FoldableDiagnosticText}" />
        </TextBlock>
        <!-- v0.60：卡顿 / 掉帧 / 建索引耗时的可复制账本。用户不必描述「感觉有点卡」，
             复制这段就能对数字定位问题。 -->
        <TextBlock Classes="caption" TextWrapping="Wrap"
                   Text="「不卡」要有数字支撑：媒体帧率、掉帧、首帧时延、建索引耗时与进度回调次数都在这里。" />
        <WrapPanel Orientation="Horizontal">
          <md:MdButton Variant="Outlined" Content="复制性能诊断" Margin="0,0,8,0"
                       Command="{Binding CopyPerformanceDiagnosticsCommand}" />
          <md:MdButton Variant="Outlined" Content="开源许可证" Click="OnLicensesClick" />
        </WrapPanel>
        <SelectableTextBlock Classes="caption" FontSize="11.5" MaxLines="14" TextWrapping="Wrap"
                             Text="{Binding PerformanceDiagnosticsText}"
                             ToolTip.Tip="复制后可贴给开发者：里面没有文件内容，只有耗时与帧节奏数字。" />
      </StackPanel>
      </Border>
          <Border Classes="card settings-card" x:Name="SettingsCardStorage">
            <StackPanel Spacing="12">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,0,0,4">
                <Border Width="40" Height="40" CornerRadius="20"
                        Background="{DynamicResource Md.Sys.Color.SecondaryContainer.Brush}">
                  <md:MdIcon Glyph="{x:Static md:MdSymbols.FolderOpen}" Size="20" HorizontalAlignment="Center" VerticalAlignment="Center"
                             Foreground="{DynamicResource Md.Sys.Color.OnSecondaryContainer.Brush}" />
              </Border>
          <TextBlock Classes="h3" Text="已授权文件夹" VerticalAlignment="Center" />
        </StackPanel>
          <TextBlock Grid.Column="1" Classes="caption" Text="{Binding AuthorizedRootsSummaryText}" VerticalAlignment="Center" />
        </Grid>
        <TextBlock Classes="caption" TextWrapping="Wrap"
                   Text="系统选择器授予的读写范围仅限所选文件夹。移除只删除 Eidoria 中的入口，不删除文件；系统侧授权仍可在系统设置中撤销。" />

        <ItemsControl ItemsSource="{Binding AuthorizedRoots}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:AuthorizedRootModel">
              <Border CornerRadius="16" Padding="12" Margin="0,0,0,8"
                      Background="{DynamicResource Md.Sys.Color.SurfaceContainer.Brush}">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                  <Border Width="40" Height="40" CornerRadius="20" VerticalAlignment="Center"
                          Background="{DynamicResource Md.Sys.Color.SurfaceContainer.Brush}">
                    <md:MdIcon Glyph="{Binding StatusGlyph}" Size="21"
                               Foreground="{DynamicResource Md.Sys.Color.Primary.Brush}" />
                  </Border>
                  <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Classes="body" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Classes="caption" Text="{Binding StateText}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Classes="caption" Text="{Binding LocationText}" TextTrimming="CharacterEllipsis"
                               ToolTip.Tip="{Binding PathToolTip}" />
                  </StackPanel>
                  <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <md:MdButton Variant="Tonal" Content="打开" IsVisible="{Binding IsAvailable}"
                                 Click="OnAuthorizedRootClick" />
                    <md:MdButton Variant="Tonal" Content="重新授权" IsVisible="{Binding NeedsReauthorization}"
                                 Click="OnReauthorizeRootClick" />
                    <md:MdIconButton Icon="{x:Static md:MdSymbols.Close}" Click="OnRemoveAuthorizedRootClick"
                                     ToolTip.Tip="移除授权入口（不删除文件）" />
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Classes="caption" Text="尚未授权文件夹；授权后才可浏览应用专属目录之外的文件。" IsVisible="{Binding !HasAuthorizedRoots}" />

        <md:MdButton Variant="Filled" HorizontalAlignment="Left" Command="{Binding PickAuthorizedFolderCommand}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <md:MdIcon Glyph="{x:Static md:MdSymbols.Add}" Size="19" />
            <TextBlock Text="授权新文件夹" VerticalAlignment="Center" />
          </StackPanel>
        </md:MdButton>

        <Border Height="1" Background="{DynamicResource Md.Sys.Color.OutlineVariant.Brush}" />
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
          <md:MdIcon Glyph="{x:Static md:MdSymbols.Delete}" Size="24" VerticalAlignment="Center"
                     Foreground="{DynamicResource Md.Sys.Color.Primary.Brush}" />
          <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
            <TextBlock Classes="body" Text="应用内回收站" />
            <TextBlock Classes="caption" TextWrapping="Wrap">
              <Run Text="{Binding TrashSummaryText}" /><Run Text=" · 上限 " /><Run Text="{Binding TrashQuotaText}" /><Run Text=" · " /><Run Text="{Binding TrashRetentionText}" />
            </TextBlock>
          </StackPanel>
          <md:MdButton Grid.Column="2" Variant="Tonal" Content="查看" Command="{Binding GoTrashCommand}" VerticalAlignment="Center" />
        </Grid>
        <md:MdLinearProgressIndicator Minimum="0" Maximum="100" Value="{Binding TrashUsedPercent}" Height="6"
                                      IsVisible="{Binding HasTrashQuota}" />
        <TextBlock Classes="caption" TextWrapping="Wrap"
                   Text="不是 Android 系统回收站；只保留经 Eidoria 删除的项目，超过上限时会保留原文件。" />

        <!-- 配额与保留期只有应用内回收站在管；桌面用系统回收站，这一组不显示以免给出假选项。 -->
        <StackPanel Spacing="2" IsVisible="{Binding UsesAppTrash}">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Classes="body" Text="回收站配额上限" />
            <TextBlock Grid.Column="1" Classes="caption" Text="{Binding AppTrashQuotaText}" VerticalAlignment="Center" />
          </Grid>
          <TextBlock Classes="caption" TextWrapping="Wrap"
                     Text="超出上限时不再接收新的删除，原文件与既有副本都会保留" />
          <WrapPanel Orientation="Horizontal" Margin="0,6,0,0">
            <md:MdButton Classes="segmented-choice" Classes.selected="{Binding IsAppTrashQuota500Mb}" Variant="Text"
                         Content="500 MB" Margin="0,0,6,0"
                         Command="{Binding SetAppTrashQuotaCommand}" CommandParameter="500" />
            <md:MdButton Classes="segmented-choice" Classes.selected="{Binding IsAppTrashQuota1Gb}" Variant="Text"
                         Content="1 GB" Margin="0,0,6,0"
                         Command="{Binding SetAppTrashQuotaCommand}" CommandParameter="1000" />
            <md:MdButton Classes="segmented-choice" Classes.selected="{Binding IsAppTrashQuota2Gb}" Variant="Text"
                         Content="2 GB"
                         Command="{Binding SetAppTrashQuotaCommand}" CommandParameter="2000" />
          </WrapPanel>
        </StackPanel>
        <StackPanel Spacing="2" IsVisible="{Binding UsesAppTrash}">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Classes="body" Text="回收站保留期" />
            <TextBlock Grid.Column="1" Classes="caption" Text="{Binding AppTrashRetentionText}" VerticalAlignment="Center" />
          </Grid>
          <TextBlock Classes="caption" TextWrapping="Wrap"
                     Text="超过保留期的条目会在下次打开回收站时自动清理；这是删除而不是还原" />
          <WrapPanel Orientation="Horizontal" Margin="0,6,0,0">
            <md:MdButton Classes="segmented-choice" Classes.selected="{Binding IsAppTrashRetention7}" Variant="Text"
                         Content="7 天" Margin="0,0,6,0"
                         Command="{Binding SetAppTrashRetentionDaysCommand}" CommandParameter="7" />
            <md:MdButton Classes="segmented-choice" Classes.selected="{Binding IsAppTrashRetention30}" Variant="Text"
                         Content="30 天" Margin="0,0,6,0"
                         Command="{Binding SetAppTrashRetentionDaysCommand}" CommandParameter="30" />
            <md:MdButton Classes="segmented-choice" Classes.selected="{Binding IsAppTrashRetention90}" Variant="Text"
                         Content="90 天"
                         Command="{Binding SetAppTrashRetentionDaysCommand}" CommandParameter="90" />
          </WrapPanel>
        </StackPanel>
      </StackPanel>
      </Border>
          <Border Classes="card settings-card" x:Name="SettingsCardMedia">
            <StackPanel Spacing="12">
              <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,0,0,4">
                <Border Width="40" Height="40" CornerRadius="20"
                        Background="{DynamicResource Md.Sys.Color.SecondaryContainer.Brush}">
                  <md:MdIcon Glyph="{x:Static md:MdSymbols.Movie}" Size="20" HorizontalAlignment="Center" VerticalAlignment="Center"
                             Foreground="{DynamicResource Md.Sys.Color.OnSecondaryContainer.Brush}" />
              </Border>
          <TextBlock Classes="h3" Text="媒体" VerticalAlignment="Center" />
        </StackPanel>
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel>
            <TextBlock Classes="body" Text="视频默认在应用内嵌播放" />
            <TextBlock Classes="caption" TextWrapping="Wrap"
                       Text="关掉时视频只给「用系统播放器打开 / 仍要内嵌观看」两个入口。内嵌画面由系统解码栈逐帧抓取，CPU 占用高于外部播放器；遇到高码率或特殊编码仍建议用系统播放器打开" />
          </StackPanel>
          <md:MdSwitch Grid.Column="1" IsChecked="{Binding PlayVideoInline}" VerticalAlignment="Center" />
        </Grid>
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel>
            <TextBlock Classes="body" Text="选中媒体后自动播放" />
            <TextBlock Classes="caption" TextWrapping="Wrap"
                       Text="只对当前平台真能播放的文件生效（探测不通过就不播）；视频还要求内嵌画面已开启" />
          </StackPanel>
          <md:MdSwitch Grid.Column="1" IsChecked="{Binding MediaAutoPlay}" VerticalAlignment="Center" />
        </Grid>
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel>
            <TextBlock Classes="body" Text="预览里显示媒体后端诊断" />
            <TextBlock Classes="caption" TextWrapping="Wrap"
                       Text="显示后端名称、画面交付方式与平台诊断文本；关掉后预览卡更干净，排查问题时再打开" />
          </StackPanel>
          <md:MdSwitch Grid.Column="1" IsChecked="{Binding ShowMediaDiagnostics}" VerticalAlignment="Center" />
        </Grid>
      </StackPanel>
      </Border>
          <Border Classes="card settings-card" x:Name="SettingsCardLocalAi">
            <StackPanel Spacing="12">
              <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,0,0,4">
                <Border Width="40" Height="40" CornerRadius="20"
                        Background="{DynamicResource Md.Sys.Color.SecondaryContainer.Brush}">
                  <md:MdIcon Glyph="{x:Static md:MdSymbols.Search}" Size="20" HorizontalAlignment="Center" VerticalAlignment="Center"
                             Foreground="{DynamicResource Md.Sys.Color.OnSecondaryContainer.Brush}" />
              </Border>
          <TextBlock Classes="h3" Text="本地 AI" VerticalAlignment="Center" />
        </StackPanel>
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel>
            <TextBlock Classes="body" Text="启用端侧 AI" />
            <TextBlock Classes="caption" TextWrapping="Wrap"
                       Text="AI 语义搜索在本机运行，不上传文件、不采集统计；只有「下载模型」这一个动作会联网（可切换下载源）。先下载默认文本模型，再到搜索中心建立 AI 索引；目前索引文件名与小型纯文本/Markdown 摘要。" />
          </StackPanel>
          <md:MdSwitch Grid.Column="1" IsChecked="{Binding EnableLocalAi}" VerticalAlignment="Center" />
        </Grid>

        <Border Background="{DynamicResource Md.Sys.Color.SurfaceContainerLow.Brush}"
                BorderBrush="{DynamicResource Md.Sys.Color.OutlineVariant.Brush}"
                BorderThickness="1" CornerRadius="12" Padding="12">
          <StackPanel Spacing="8">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Classes="body" Text="{Binding LocalAiStatusText}" TextWrapping="Wrap" />
              <md:MdButton Grid.Column="1" Variant="Text" Content="重新检查"
                           Command="{Binding RefreshLocalAiCommand}" />
            </Grid>

            <ItemsControl ItemsSource="{Binding LocalAiModels}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:AiModelStatusModel">
                  <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" Margin="0,2">
                    <StackPanel Spacing="1">
                      <TextBlock Classes="body" Text="{Binding Name}" />
                      <TextBlock Classes="caption" TextWrapping="Wrap"
                                 Text="{Binding Purpose}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Right" Spacing="1">
                      <TextBlock Classes="caption" HorizontalAlignment="Right"
                                 Text="{Binding StatusText}" />
                      <TextBlock Classes="caption" HorizontalAlignment="Right"
                                 Text="{Binding LicenseText}" />
                      <TextBlock Classes="caption" HorizontalAlignment="Right"
                                 Text="{Binding SizeText}" />
                    </StackPanel>
                    <md:MdButton Grid.Column="2" Variant="Text" VerticalAlignment="Center"
                                 Content="{Binding DownloadButtonText}"
                                 Command="{Binding DownloadCommand}"
                                 ToolTip.Tip="{Binding DownloadHint}">
                    </md:MdButton>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel Spacing="6">
              <TextBlock Classes="body" Text="下载源" />
              <md:MdSegmentedButtonGroup SelectedValue="{Binding AiModelSourceName, Mode=TwoWay}"
                                         SelectedValueBinding="{Binding Value}">
                <md:MdSegmentedButton Value="Auto" Content="自动回落"
                                      ToolTip.Tip="huggingface.co → hf-mirror.com → modelscope.cn 依次尝试" />
                <md:MdSegmentedButton Value="HuggingFace" Content="HuggingFace" />
                <md:MdSegmentedButton Value="HfMirror" Content="hf-mirror" />
                <md:MdSegmentedButton Value="ModelScope" Content="魔搭" />
              </md:MdSegmentedButtonGroup>
              <TextBlock Classes="caption" TextWrapping="Wrap" Text="{Binding AiModelSourceHintText}" />

              <WrapPanel Orientation="Horizontal">
                <md:MdButton Variant="Filled" Margin="0,0,8,6" Content="下载默认包"
                             Command="{Binding DownloadDefaultAiModelsCommand}"
                             IsEnabled="{Binding CanDownloadAiModels}" />
                <md:MdButton Variant="Outlined" Margin="0,0,8,6" Content="全部下载"
                             Command="{Binding DownloadAllAiModelsCommand}"
                             IsEnabled="{Binding CanDownloadAiModels}" />
                <md:MdButton Variant="Outlined" Margin="0,0,8,6" Content="校验已下载"
                             Command="{Binding VerifyAiModelsCommand}"
                             IsEnabled="{Binding CanDownloadAiModels}"
                             ToolTip.Tip="按 checksums.txt 复核 SHA-256；没有记录的文件会如实标注" />
              </WrapPanel>
              <TextBlock Classes="caption" TextWrapping="Wrap" Text="{Binding LocalAiDefaultPackageText}" />

              <!-- v0.61：下载进行中就地显示实时进度条，不必打开任务中心也知道在下什么。 -->
              <StackPanel Spacing="4" IsVisible="{Binding IsLocalAiDownloadBusy}">
                <md:MdLinearProgressIndicator Value="{Binding AiModelDownloadPercent}" Maximum="100"
                                              IndicatorBrush="{DynamicResource Md.Sys.Color.Primary.Brush}" />
                <TextBlock Classes="caption" TextWrapping="Wrap" Text="{Binding LocalAiDownloadStatusText}" />
              </StackPanel>
              <TextBlock Classes="caption" TextWrapping="Wrap" Text="{Binding LocalAiDownloadStatusText}"
                         IsVisible="{Binding !IsLocalAiDownloadBusy}" />

              <!-- v0.61：代理三档——跟随系统/直连/自定义 HTTP 代理（走 HuggingFace 的网络环境很常见）。 -->
              <StackPanel Spacing="6" Margin="0,4,0,0">
                <TextBlock Classes="body" Text="下载代理" />
                <md:MdSegmentedButtonGroup SelectedValue="{Binding AiModelProxyMode, Mode=TwoWay}"
                                           SelectedValueBinding="{Binding Value}">
                  <md:MdSegmentedButton Value="System" Content="跟随系统" />
                  <md:MdSegmentedButton Value="None" Content="直连" />
                  <md:MdSegmentedButton Value="Custom" Content="自定义" />
                </md:MdSegmentedButtonGroup>
                <md:MdTextBox Variant="Outlined" Label="代理地址（http://host:port 或 host:port）"
                              Watermark="例如 http://127.0.0.1:7890"
                              Text="{Binding AiModelProxyAddress, Mode=TwoWay}"
                              IsVisible="{Binding AiModelProxyIsCustom}" />
                <TextBlock Classes="caption" TextWrapping="Wrap" Text="{Binding AiModelProxySummaryText}"
                           Foreground="{DynamicResource Md.Sys.Color.OnSurfaceVariant.Brush}" />
              </StackPanel>

              <TextBlock Classes="caption" TextWrapping="Wrap"
                         Text="{Binding LocalAiModelsDirectoryText}" />
              <md:MdButton Variant="Text" HorizontalAlignment="Left" Content="打开模型目录"
                           Command="{Binding OpenLocalAiFolderCommand}" />
              <StackPanel Spacing="2">
                <TextBlock Classes="caption" TextWrapping="Wrap"
                           Text="下载走任务中心（可取消；中断后保留 .part，下次接着续）。命令行脚本保留给离线/批量场景：" />
                <Grid ColumnDefinitions="*,Auto">
                  <SelectableTextBlock Classes="mono" Text="{Binding LocalAiDownloadCommandText}"
                                       TextWrapping="Wrap" VerticalAlignment="Center" />
                  <md:MdButton Grid.Column="1" Variant="Text" Content="复制命令"
                               Command="{Binding CopyLocalAiDownloadCommandCommand}" />
                </Grid>
              </StackPanel>
            </StackPanel>
          </StackPanel>
        </Border>
      </StackPanel>
      </Border>
          <Border Classes="card settings-card" x:Name="SettingsCardSearch">
            <StackPanel Spacing="12">
              <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,0,0,4">
                <Border Width="40" Height="40" CornerRadius="20"
                        Background="{DynamicResource Md.Sys.Color.SecondaryContainer.Brush}">
                  <md:MdIcon Glyph="{x:Static md:MdSymbols.Search}" Size="20" HorizontalAlignment="Center" VerticalAlignment="Center"
                             Foreground="{DynamicResource Md.Sys.Color.OnSecondaryContainer.Brush}" />
              </Border>
          <TextBlock Classes="h3" Text="搜索" VerticalAlignment="Center" />
        </StackPanel>
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel>
            <TextBlock Classes="body" Text="文件名索引" />
            <TextBlock Classes="caption" Text="只索引显式加入的本地文件夹；关闭后递归搜索改走实时扫描" />
          </StackPanel>
          <md:MdSwitch Grid.Column="1" IsChecked="{Binding UseSearchIndex}" VerticalAlignment="Center" />
        </Grid>
        <StackPanel Spacing="2">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Classes="body" Text="搜索结果上限" />
            <TextBlock Grid.Column="1" Classes="caption" Text="{Binding SearchResultLimitText}" VerticalAlignment="Center" />
          </Grid>
          <TextBlock Classes="caption" TextWrapping="Wrap"
                     Text="递归搜索与搜索中心单次最多返回的条数；达到上限时结果会被截断，不会静默当成全部" />
          <md:MdSlider Margin="0,6,0,0" Minimum="500" Maximum="10000" TickFrequency="500"
                       IsSnapToTickEnabled="True" Value="{Binding SearchResultLimitNumber, Mode=TwoWay}"
                       ShowValueIndicator="True" ValueFormat="0"
                       ToolTip.Tip="单次搜索最多返回条数（500–10000）"
                       AutomationProperties.Name="搜索结果上限" />
        </StackPanel>
        <TextBlock Classes="caption">
          <Run Text="{Binding SearchIndexStateText}" /><Run Text=" · " /><Run Text="{Binding SearchIndexEntryCountText}" /><Run Text=" 项 · " /><Run Text="{Binding SearchIndexSizeText}" />
        </TextBlock>
        <TextBlock Classes="caption">
          <Run Text="更新：" /><Run Text="{Binding SearchIndexUpdatedText}" />
        </TextBlock>
        <WrapPanel Orientation="Horizontal">
          <md:MdButton Variant="Tonal" Content="搜索中心" Margin="0,0,8,8" Command="{Binding GoSearchCenterCommand}" />
          <md:MdButton Variant="Outlined" Content="重建索引" Margin="0,0,8,8" Command="{Binding RebuildSearchIndexCommand}" />
          <md:MdButton Variant="Outlined" Content="清除索引" Margin="0,0,8,8" Command="{Binding ClearSearchIndexCommand}" />
        </WrapPanel>
      </StackPanel>
      </Border>
          <Border Classes="card settings-card" x:Name="SettingsCardNotifications">
            <StackPanel Spacing="12">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,0,0,4">
                <Border Width="40" Height="40" CornerRadius="20"
                        Background="{DynamicResource Md.Sys.Color.SecondaryContainer.Brush}">
                  <md:MdIcon Glyph="{x:Static md:MdSymbols.NotificationsActive}" Size="20" HorizontalAlignment="Center" VerticalAlignment="Center"
                             Foreground="{DynamicResource Md.Sys.Color.OnSecondaryContainer.Brush}" />
              </Border>
          <TextBlock Classes="h3" Text="系统通知" VerticalAlignment="Center" />
        </StackPanel>
          <TextBlock Grid.Column="1" Classes="caption" Text="{Binding SystemNotificationPlatformText}" VerticalAlignment="Center" />
        </Grid>
        <TextBlock Classes="caption" TextWrapping="Wrap" Text="{Binding SystemNotificationSupportText}" />
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel>
            <TextBlock Classes="body" Text="长任务完成时通知" />
            <TextBlock Classes="caption" TextWrapping="Wrap"
                       Text="失败任务会立即提醒；成功任务仅在运行至少 3 秒后提醒，短操作仍只显示应用内提示" />
          </StackPanel>
          <md:MdSwitch Grid.Column="1" IsChecked="{Binding NotifyOnTaskCompletion}" VerticalAlignment="Center" />
        </Grid>
        <TextBlock Classes="caption" TextWrapping="Wrap" Text="{Binding SystemNotificationStatusText}" />
        <md:MdButton Variant="Tonal" HorizontalAlignment="Left"
                     Command="{Binding SendTestSystemNotificationCommand}"
                     IsEnabled="{Binding !IsSendingTestSystemNotification}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <md:MdIcon Glyph="{x:Static md:MdSymbols.NotificationsActive}" Size="19" />
            <TextBlock Text="发送测试通知" VerticalAlignment="Center" />
          </StackPanel>
        </md:MdButton>
      </StackPanel>
      </Border>
          </StackPanel>
        </md:MdScrollViewer>
      </Grid>
    </Grid>
  </Grid>
</UserControl>
